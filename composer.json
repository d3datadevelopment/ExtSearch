{
  "name": "d3/extsearch",
  "description": "Extended search module for OXID eShop.",
  "type": "oxideshop-module",
  "keywords": [
    "oxid",
    "modules",
    "eShop",
    "d3",
    "search",
    "d3dependencycheck",
    "id_d3_extsearch"
  ],
  "authors": [
    {
        "name": "D3 Data Development (Inh. Thomas Dartsch)",
        "email": "info@shopmodule.com",
        "homepage": "https://www.d3data.de",
        "role": "Owner"
    }
  ],
  "support": {
    "email": "support@shopmodule.com"
  },
  "homepage": "https://www.oxidmodule.com/",
  "license": [
    "proprietary"
  ],
  "suggest": {
    "d3/prg-redirects": "prevents unwanted reloading of filtered results when using the Browsers Back function, improves the user experience",
    "oxid-projects/statistics-module": "allows the graphical evaluation of statistics"
  },
  "require": {
    "php": "^8.0",
    "ext-sourceguardian": ">=16",
    "oxid-esales/oxideshop-ce": "7.0 - 7.5",
    "d3/modcfg": "^7.1",
    "d3/oxid-sql-logger": "^2.0.0",
    "splitbrain/php-cli": "^1.2.0",
    "szepeviktor/package-path": "^0.3",
    "beberlei/assert": "^3.3"
  },
  "require-dev": {
    "d3/testingtools": "^1.2.0.0",
    "phpunit/phpunit": "^9.1.1",
    "friendsofphp/php-cs-fixer": "~3.13.0",
    "phpstan/phpstan": "^1.10",
    "boxblinkracer/phpunuhi": "^1.12",
    "rector/rector": "^0.18.13"
  },
  "autoload": {
    "psr-4": {
      "D3\\Extsearch\\": ""
    }
  },
  "bin": ["bin/d3_extsearch_cron"],
  "scripts": {
    "php-cs-fixer_audit": "XDEBUG_MODE=off ./vendor/bin/php-cs-fixer list-files --config=./vendor/d3/extsearch/.ci-tools/.php-cs-fixer.php",
    "php-cs-fixer_fix": "XDEBUG_MODE=off ./vendor/bin/php-cs-fixer fix --config=./vendor/d3/extsearch/.ci-tools/.php-cs-fixer.php",

    "phpstan": "XDEBUG_MODE=off ./vendor/bin/phpstan --configuration=vendor/d3/extsearch/.ci-tools/phpstan.neon analyse",
    "phpstan-report": "XDEBUG_MODE=off ./vendor/bin/phpstan --configuration=vendor/d3/extsearch/.ci-tools/phpstan.neon analyse --error-format=json > vendor/d3/extsearch/tests/phpstan.report.json",


    "phpunit": "XDEBUG_MODE=off ./vendor/bin/phpunit --config=vendor/d3/extsearch/.ci-tools/ --no-coverage",
    "phpunit-line-coverage": "XDEBUG_MODE=coverage ./vendor/bin/phpunit --config=vendor/d3/extsearch/.ci-tools/ --coverage-html=reports/phpunit/extsearch",
    "phpunit-path-coverage": "XDEBUG_MODE=coverage ./vendor/bin/phpunit --config=vendor/d3/extsearch/.ci-tools/ --coverage-html=--coverage-html=reports/phpunit/extsearch --path-coverage",

    "phpunuhi": "./vendor/bin/phpunuhi --configuration=vendor/d3/extsearch/.ci-tools/phpunuhi.xml validate"
  }
}
